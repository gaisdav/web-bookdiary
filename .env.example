PUBLIC_SUPABASE_URL=your_supabase_url_here
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

PUBLIC_SUPPORT_EMAIL=email

# App Store link shown on the deep-link fallback pages (Google Play lives in src/lib/storeLinks.ts)
PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
# Numeric App Store ID (the idXXXXXXXXX above, digits only) — enables the iOS Smart App Banner. Leave empty to omit the banner.
PUBLIC_IOS_APP_ID=
