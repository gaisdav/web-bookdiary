PUBLIC_SUPABASE_URL=your_supabase_url_here
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

PUBLIC_SUPPORT_EMAIL=email

# Public origin of this site, no trailing slash — used to build the Smart App
# Banner's app-argument, which tells the app which page the user came from.
PUBLIC_SITE_URL=https://web-bookdiary.vercel.app

# Shown on the deep-link fallback pages (/book/:id, /user/:userId/list/:listId,
# /email-verified). Each is optional; a link is omitted when its variable is empty.

# Numeric App Store ID (digits only) — enables both the iOS Smart App Banner and
# the App Store link. Leave empty until the app is live on the App Store.
PUBLIC_IOS_APP_ID=
PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.appbookdiary
# Custom URL scheme the app registers, without "://" — renders an explicit
# "Open in the BookDiary app" link. Leave empty to omit it.
PUBLIC_APP_SCHEME=
